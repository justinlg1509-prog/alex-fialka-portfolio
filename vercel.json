{
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/aviso-legal.html", "destination": "/es/aviso-legal/", "statusCode": 301 },
    { "source": "/privacidad.html", "destination": "/es/privacidad/", "statusCode": 301 },
    { "source": "/politica-privacidad.html", "destination": "/es/privacidad/", "statusCode": 301 },
    { "source": "/cookies.html", "destination": "/es/cookies/", "statusCode": 301 },
    { "source": "/politica-cookies.html", "destination": "/es/cookies/", "statusCode": 301 },
    { "source": "/en/enterprise-thinking/:path*", "destination": "/en/#enterprise-thinking", "statusCode": 301 },
    { "source": "/en/book/:path*", "destination": "/en/#books", "statusCode": 301 },
    { "source": "/en/about/:path*", "destination": "/en/#about", "statusCode": 301 },
    { "source": "/en/contact/:path*", "destination": "/en/#contact", "statusCode": 301 },
    { "source": "/es/enterprise-thinking/:path*", "destination": "/es/#enterprise-thinking", "statusCode": 301 },
    { "source": "/es/libro/:path*", "destination": "/es/#books", "statusCode": 301 },
    { "source": "/es/sobre-alex/:path*", "destination": "/es/#about", "statusCode": 301 },
    { "source": "/es/contacto/:path*", "destination": "/es/#contact", "statusCode": 301 },
    { "source": "/nl/enterprise-thinking/:path*", "destination": "/nl/#enterprise-thinking", "statusCode": 301 },
    { "source": "/nl/boek/:path*", "destination": "/nl/#books", "statusCode": 301 },
    { "source": "/nl/over-alex/:path*", "destination": "/nl/#about", "statusCode": 301 },
    { "source": "/nl/contact/:path*", "destination": "/nl/#contact", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000" }]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
